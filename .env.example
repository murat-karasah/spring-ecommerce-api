# Copy this file to .env and fill in real values
# Never commit .env to version control

# Database
DB_URL=jdbc:postgresql://localhost:5432/ecommerce_db
DB_USERNAME=ecommerce_user
DB_PASSWORD=ecommerce_pass

# JWT — use a strong random secret in production (min 32 chars)
JWT_SECRET=changeme-replace-with-a-strong-random-secret-key

# Token expiration (milliseconds)
JWT_ACCESS_EXPIRATION=900000      # 15 minutes
JWT_REFRESH_EXPIRATION=604800000  # 7 days

# Spring profile
SPRING_PROFILES_ACTIVE=dev
